-- Find Ponds
local function getAvailablePonds()
    local ponds = {}
    local scripted = workspace:FindFirstChild("Scripted")
    local pondAreas = scripted and scripted:FindFirstChild("PondAreas")
    if pondAreas then
        for _, v in ipairs(pondAreas:GetChildren()) do
            if v:IsA("BasePart") then
                table.insert(ponds, v)
            end
        end
    end
    local tutAreas = scripted and scripted:FindFirstChild("TutorialAreas")
    if tutAreas then
        for _, t in ipairs(tutAreas:GetChildren()) do
            for _, v in ipairs(t:GetChildren()) do
                if v:IsA("BasePart") and string.find(v.Name, "Pond") then
                    table.insert(ponds, v)
                end
            end
        end
    end
    return ponds
end

local function getTargetPond()
    local ponds = getAvailablePonds()
    if #ponds == 0 then return nil end

    if Config.SelectedPond ~= "Nearest" then
        for _, p in ipairs(ponds) do
            if p.Name == Config.SelectedPond then
                return p
            end
        end
    end

    local hrp = getHRP()
    if not hrp then return ponds[1] end

    local closest = ponds[1]
    local minDist = (ponds[1].Position - hrp.Position).Magnitude
    for i = 2, #ponds do
        local dist = (ponds[i].Position - hrp.Position).Magnitude
        if dist < minDist then
            minDist = dist
            closest = ponds[i]
        end
    end
    return closest
end

