-- Auto Fish Worker Loop
task.spawn(function()
    while true do
        task.wait(0.2)
        if Config.AutoFish then
            pcall(function()
                local pond = getTargetPond()
                local hrp = getHRP()
                if pond and hrp then
                    -- If standing too far (> 40 studs), bring closer to edge
                    local dist = (pond.Position - hrp.Position).Magnitude
                    if dist > 35 then
                        hrp.CFrame = pond.CFrame + Vector3.new(0, 4, 15)
                        task.wait(0.3)
                    end

                    -- Use game's native auto-fish if available, else fire remotes
                    local renvG = nil
                    pcall(function() renvG = getrenv()._G end)
                    if renvG and type(renvG.__AF_SetForcedAutoFish) == "function" and type(renvG.__AF_StartFishingAt) == "function" then
                        renvG.__AF_SetForcedAutoFish(true)
                        renvG.__AF_StartFishingAt(pond.Position, true)
                    else
                        local reqRem = Remotes and Remotes:FindFirstChild("FishingRequestStart")
                        if reqRem then
                            reqRem:FireServer(pond, pond.Position)
                        end
                    end

                    -- Reel clicks
                    local clickRem = Remotes and Remotes:FindFirstChild("FishingClick")
                    if clickRem then
                        for i = 1, 8 do
                            if not Config.AutoFish then break end
                            clickRem:FireServer()
                            task.wait(Config.FishClickDelay)
                        end
                    end
                end
            end)
        end
    end
end)

